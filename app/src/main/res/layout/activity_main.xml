<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone home default screen — Figma 85:3451
    Browser Color System v3.0 token mappings applied throughout.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Header background — 412×426dp, opacity 0.6
         ═══════════════════════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_bg_height"
        android:scaleType="centerCrop"
        android:alpha="0.6"
        android:src="@drawable/home_header_bg"
        android:contentDescription="@null" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         Scrollable content area
         ═══════════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="80dp">

            <!-- ─── Logo — 64×64dp, 159dp from canvas top ──────────────── -->
            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/logo_margin_top"
                android:src="@drawable/brand_logo"
                android:contentDescription="@null" />

            <!-- ─── Search card — 364dp wide, rounded 16dp ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/search_card_margin_horizontal"
                android:layout_marginEnd="@dimen/search_card_margin_horizontal"
                android:layout_marginTop="@dimen/search_card_margin_top"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/search_card_elevation"
                app:cardBackgroundColor="@color/surface_raised"
                app:strokeWidth="0.5dp"
                app:strokeColor="@color/border_strong">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/search_card_padding">

                    <!-- Search input placeholder row -->
                    <TextView
                        android:id="@+id/search_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/search_input_height"
                        android:paddingStart="4dp"
                        android:paddingTop="4dp"
                        android:text="@string/search_placeholder"
                        android:textColor="@color/text_placeholder"
                        android:textSize="16sp"
                        android:gravity="top|start" />

                    <!-- Toolbar: mode tab + engine + camera/voice -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/search_toolbar_height"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <!-- Search mode tab ─ 搜全网 / 问AI -->
                        <LinearLayout
                            android:id="@+id/search_mode_tab"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/search_mode_tab_height"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_search_mode_tab"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/tab_search_web"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/search_tab_item_height"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/search_web"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:background="@drawable/bg_tab_active" />

                            <TextView
                                android:id="@+id/tab_ask_ai"
                                android:layout_width="52dp"
                                android:layout_height="@dimen/search_tab_item_height"
                                android:text="@string/ask_ai"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- Engine selector ─ 百度 / ▼ -->
                        <LinearLayout
                            android:id="@+id/engine_selector"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/engine_selector_height"
                            android:orientation="horizontal"
                            android:layout_marginStart="8dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_engine_selector">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/engine_name"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="@dimen/engine_dropdown_size"
                                android:layout_height="@dimen/engine_dropdown_size"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/engine_dropdown"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- Camera icon -->
                        <ImageView
                            android:id="@+id/btn_camera"
                            android:layout_width="@dimen/search_icon_size"
                            android:layout_height="@dimen/search_icon_size"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/search_camera"
                            android:contentDescription="@null" />

                        <!-- Voice icon -->
                        <ImageView
                            android:id="@+id/btn_voice"
                            android:layout_width="@dimen/search_icon_size"
                            android:layout_height="@dimen/search_icon_size"
                            android:src="@drawable/search_microphone"
                            android:contentDescription="@null" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Site grid — 5 columns × 3 rows, 11 shortcuts + add ── -->
            <LinearLayout
                android:id="@+id/site_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/grid_margin_horizontal"
                android:layout_marginEnd="@dimen/grid_margin_horizontal"
                android:layout_marginTop="@dimen/grid_margin_top"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- ── Row 1: 书签 历史 精选 游戏 微博 ──────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <!-- 书签 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_bookmarks"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_bookmarks"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 历史 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_history"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_history"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 精选 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_curated"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_curated"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 游戏 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_games"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_games"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 微博 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_weibo"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_weibo"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ── Row 2: 小说 百度 爱奇艺 优酷 知乎 ────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <!-- 小说 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_novel"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_novel"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 百度 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_baidu"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_baidu"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 爱奇艺 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_iqiyi"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_iqiyi"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 优酷 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_youku"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_youku"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 知乎 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_zhihu"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_zhihu"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ── Row 3: 京东 + 添加 (2 items, 3 empty slots) ──── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- 京东 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_jd"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_jd"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 添加 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="@dimen/shortcut_icon_size"
                            android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_add"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/shortcut_add"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Empty slots to complete 5-column layout -->
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Bottom area — nav + system bar
         ═══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Bottom navigation bar — 5 icons, 60dp, surface_raised bg -->
        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/bottom_nav_padding_horizontal"
            android:paddingEnd="@dimen/bottom_nav_padding_horizontal"
            android:paddingTop="@dimen/bottom_nav_padding_top"
            android:gravity="center_vertical"
            android:background="@color/surface_raised">

            <ImageView
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_recommend"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_video"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_home"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_reading"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_menu"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- System navigation bar area — 20dp with gesture handle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/system_nav_bar_height"
            android:gravity="center"
            android:background="@color/surface_canvas">

            <View
                android:layout_width="@dimen/system_nav_handle_width"
                android:layout_height="@dimen/system_nav_handle_height"
                android:background="@drawable/bg_nav_handle"
                android:contentDescription="@null" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
