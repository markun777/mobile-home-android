<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone home default screen — Figma 571:44695 (updated 2026-05-29)
    Source node: 571:44695 / 首页
    Browser Color System v3.0 token mappings applied throughout.

    Changes from 85:3451 baseline:
    - Bottom nav: icon-only → icon+label (主页/推荐/视频/小说/菜单)
    - Tab manager button added (top-right, 28×28dp)
    - Search placeholder: 告诉我想要了解的内容 → 输入关键信息
    - Search AI tab: 问AI → AI搜索
    - Search card width: 364dp → 380dp (margin 16dp each side)
    - Shortcut grid reordered + 短剧 added (row1: 书签/历史记录/免费小说/短剧/小游戏)
    - Engine selector removed from search toolbar
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Scrollable content area
         ═══════════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="60dp">

            <!-- ─── Header bar — 40dp, tab manager right-aligned ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingEnd="17dp"
                android:clipChildren="false">

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/tab_manager_btn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:clipChildren="false">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_tab_manager_button" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/tab_count"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </FrameLayout>

            </LinearLayout>


            <!-- ─── Logo — offset 20% above center (3:7 ratio) ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="3" />

                <ImageView
                    android:id="@+id/brand_logo"
                    android:layout_width="@dimen/logo_size"
                    android:layout_height="@dimen/logo_size"
                    android:src="@drawable/brand_logo"
                    android:contentDescription="@null" />

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="7" />
            </LinearLayout>

            <!-- ─── Search card — 380dp wide, MaterialCardView shadow (color not tunable) ─── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="6dp"
                android:outlineSpotShadowColor="#60000000"
                android:outlineAmbientShadowColor="#50000000"
                app:cardBackgroundColor="@color/surface_raised"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_strong">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/search_card_padding">

                    <!-- Search input placeholder row -->
                    <TextView
                        android:id="@+id/search_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:paddingStart="4dp"
                        android:paddingTop="4dp"
                        android:text="@string/search_placeholder"
                        android:textColor="@color/text_placeholder"
                        android:textSize="14sp"
                        android:gravity="top|start" />

                    <!-- Toolbar: mode tab + camera/voice -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/search_toolbar_height"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <!-- Search mode tab ─ 搜全网 / AI搜索 -->
                        <LinearLayout
                            android:id="@+id/search_mode_tab"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/search_mode_tab_height"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_search_mode_tab"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/tab_search_web"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/search_tab_item_height"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/search_web"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:background="@drawable/bg_tab_active" />

                            <TextView
                                android:id="@+id/tab_ask_ai"
                                android:layout_width="52dp"
                                android:layout_height="@dimen/search_tab_item_height"
                                android:text="@string/ask_ai"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp"
                                android:gravity="center" />

                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- Camera icon -->
                        <ImageView
                            android:id="@+id/btn_camera"
                            android:layout_width="@dimen/search_icon_size"
                            android:layout_height="@dimen/search_icon_size"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/search_camera"
                            android:contentDescription="@null" />

                        <!-- Voice icon -->
                        <ImageView
                            android:id="@+id/btn_voice"
                            android:layout_width="@dimen/search_icon_size"
                            android:layout_height="@dimen/search_icon_size"
                            android:src="@drawable/search_microphone"
                            android:contentDescription="@null" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Site grid — fills remaining space, fixed 12dp top gap ─── -->
            <LinearLayout
                android:id="@+id/site_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4"
                android:layout_marginTop="24dp"
                android:layout_marginStart="@dimen/grid_margin_horizontal"
                android:layout_marginEnd="@dimen/grid_margin_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:gravity="center_horizontal">

                <!-- ── Row 1: 书签 历史记录 免费小说 短剧 小游戏 ──────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_bookmarks" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_bookmarks"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_history" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_history"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_novel" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_novel"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_drama" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_drama"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_games" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_games"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Row 2: 网址精选 爱奇艺 微博 优酷 百度 ──────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_curated" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_curated"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_iqiyi" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_iqiyi"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_weibo" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_weibo"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_youku" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_youku"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_baidu" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_baidu"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Row 3: 知乎 京东 添加(+) ──────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_zhihu" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_zhihu"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_jd" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_jd"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingVertical="8dp" android:gravity="center_horizontal">
                        <ImageView android:layout_width="@dimen/shortcut_icon_size" android:layout_height="@dimen/shortcut_icon_size"
                            android:src="@drawable/shortcut_add" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/shortcut_add"
                            android:textColor="@color/text_primary" android:textSize="12sp" android:gravity="center" />
                    </LinearLayout>

                    <Space android:layout_width="16dp" android:layout_height="0dp" />
                    <!-- empty slots for column alignment -->
                    <Space android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" />

                    <Space android:layout_width="16dp" android:layout_height="0dp" />

                    <Space android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ═══════════════════════════════════════════════════════════════════════
         Bottom area — nav + system bar
         ═══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/surface_canvas">

        <!-- Bottom navigation bar — 5 tabs, 28dp each, distributed -->
        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 主页 (28×28 icon + label) -->
            <LinearLayout
                android:layout_width="28dp" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:layout_gravity="center_vertical">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/nav_home" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp" android:textColor="@color/text_primary"
                    android:text="@string/nav_home" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- 推荐 -->
            <LinearLayout
                android:layout_width="28dp" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:layout_gravity="center_vertical">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/nav_recommend" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp" android:textColor="@color/text_primary"
                    android:text="@string/nav_recommend" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- 视频 -->
            <LinearLayout
                android:layout_width="28dp" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:layout_gravity="center_vertical">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/nav_video" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp" android:textColor="@color/text_primary"
                    android:text="@string/nav_video" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- 小说 -->
            <LinearLayout
                android:layout_width="28dp" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:layout_gravity="center_vertical">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/nav_novel" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp" android:textColor="@color/text_primary"
                    android:text="@string/nav_novel" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- 菜单 -->
            <LinearLayout
                android:layout_width="28dp" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:layout_gravity="center_vertical">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/nav_menu" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp" android:textColor="@color/text_primary"
                    android:text="@string/nav_menu" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
