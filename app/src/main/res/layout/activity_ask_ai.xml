<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone Ask AI — Figma node 91:4404 (412×914)
    Source: tJamKVuAm0fELLoddNqQ9A / 移动端首页改版
    Board: Ask AI conversational interface
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/phone_canvas_width"
    android:layout_height="@dimen/phone_canvas_height"
    android:orientation="vertical"
    android:background="@color/surface_canvas">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Status bar — 36dp (system-owned, rendered for layout accuracy)
         ═══════════════════════════════════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_reference" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         Header bar — 48dp: back | title | history
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@color/surface_raised">

        <!-- Left: back button (40×40 hit, 24×24 icon) -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="@string/back" />
        </FrameLayout>

        <!-- Center: title "问AI" -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/ask_ai_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Right: history icon -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/history" />
        </FrameLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Hero Greeting Area — 380dp wide, centered vertically
         Spans remaining height between header and input
         ═══════════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <!-- Title: gradient text -->
            <TextView
                android:id="@+id/hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ask_ai_hero_title"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/hero_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ask_ai_hero_subtitle"
                android:textColor="@color/text_tertiary"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Chat Input Bar — Figma component 171:6980 (移动端对话输入框)
         Height: ~116dp + bottom padding
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_raised"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <!-- Input card — rounded 16dp, blue border -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_card"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Text input area -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="4dp"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Blinking cursor -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="4dp"
                            android:background="#2665f1" />

                        <!-- Input hint -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ask_ai_input_hint"
                            android:textColor="#999999"
                            android:textSize="16sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <!-- Toolbar row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Left: model + deep think -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Model selector: 豆包 + dropdown -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:background="@drawable/bg_model_selector">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="4dp"
                                android:text="@string/model_name_doubao"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_dropdown_arrow"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <!-- 深度思考 toggle -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:background="@drawable/bg_model_selector">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="4dp"
                                android:text="@string/deep_think"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Right: camera + voice -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Camera -->
                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/search_camera"
                                android:contentDescription="@string/camera" />
                        </FrameLayout>

                        <!-- Voice -->
                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/search_microphone"
                                android:contentDescription="@string/voice" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Keyboard placeholder — 368dp, gray
         ═══════════════════════════════════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="368dp"
        android:background="@color/fill_quaternary"
        android:alpha="0.3" />

</LinearLayout>
